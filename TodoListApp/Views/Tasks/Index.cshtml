@model IEnumerable<TodoListApp.Models.TaskItem>

@{
    ViewData["Title"] = "Your Tasks";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Your Tasks</h2>
        <a asp-action="Create" class="btn btn-primary">+ Add New Task</a>
    </div>

    <!-- Time Filters -->
    <div class="mb-3">
        <span class="fw-bold me-2">Filter by:</span>
        <a asp-action="Index" class="btn btn-sm @(ViewBag.CurrentFilter == null ? "btn-dark" : "btn-outline-dark")">All</a>
        <a asp-action="Index" asp-route-timeFilter="urgent" class="btn btn-sm @(ViewBag.CurrentFilter == "urgent" ? "btn-danger" : "btn-outline-danger")">Due in 24h</a>
        <a asp-action="Index" asp-route-timeFilter="upcoming" class="btn btn-sm @(ViewBag.CurrentFilter == "upcoming" ? "btn-success" : "btn-outline-success")">Upcoming</a>
        <a asp-action="Index" asp-route-timeFilter="overdue" class="btn btn-sm @(ViewBag.CurrentFilter == "overdue" ? "btn-secondary" : "btn-outline-secondary")">Overdue</a>
    </div>

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Deadline</th>
                <th>File</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No tasks found. Click "Add New Task" to create one!</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    // Check if deadline is 24 hours or less away and not already passed
                    bool isUrgent = item.Deadline > DateTime.Now && item.Deadline <= DateTime.Now.AddHours(24);
                    string deadlineClass = isUrgent ? "bg-danger text-white fw-bold" : "";

                    <tr>
                        <td class="fw-bold">@item.Title</td>
                        <td>@(item.Description ?? "No description")</td>
                        <td class="@deadlineClass">
                            @item.Deadline.ToString("yyyy-MM-dd HH:mm")
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.OriginalFileName))
                            {
                                <a asp-action="DownloadFile" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">
                                    <i class="bi bi-download"></i> Download (@item.OriginalFileName)
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">No file</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                            <button type="button" class="btn btn-sm btn-danger" onclick="confirmDelete(@item.Id)">Delete</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-timeFilter="@ViewBag.CurrentFilter">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<!-- SweetAlert2 Script for Delete Confirmation -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Tasks/Delete/' + id;
                }
            })
        }
    </script>
}